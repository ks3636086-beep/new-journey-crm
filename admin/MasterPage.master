<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Admin Panel |New Journey Holidays CRM</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons 1.11.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Custom Admin Theme CSS (Kept inside admin folder) -->
    <link href="css/admin-style.css" rel="stylesheet" />

    <!-- Bootstrap 5.3.3 JS Bundle (in Head so Server Startup Scripts can call bootstrap modals) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Mobile Sidebar Offcanvas -->
        <div class="offcanvas offcanvas-start bg-dark text-white d-lg-none" tabindex="-1" id="mobileSidebar" style="background-color: var(--nj-sidebar-bg) !important; width: 295px;">
            <div class="offcanvas-header border-bottom border-secondary border-opacity-25 p-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="nj-sidebar-brand p-0 border-0">
                        <img src="images/logo.png" alt="New Journey Holidays" class="brand-logo-img" />
                        <div>
                            <div class="brand-title">New Journey Holidays</div>

                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                <div class="nj-nav-category">Main Menu</div>
                <ul class="nj-nav-list">
                    <li class="nj-nav-item"><a href="Dashboard.aspx" class="nj-nav-link" id="mob-nav-dashboard"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a></li>
                    <li class="nj-nav-item"><a href="AllLeads.aspx" class="nj-nav-link" id="mob-nav-allleads"><i class="bi bi-person-lines-fill"></i><span>All Leads</span></a></li>
                    <li class="nj-nav-item"><a href="AddLead.aspx" class="nj-nav-link" id="mob-nav-addlead"><i class="bi bi-person-plus-fill"></i><span>Add Lead</span></a></li>
                    <li class="nj-nav-item"><a href="AssignLeads.aspx" class="nj-nav-link" id="mob-nav-assignleads"><i class="bi bi-arrow-left-right"></i><span>Assign Leads</span></a></li>
                    <li class="nj-nav-item"><a href="Bookings.aspx" class="nj-nav-link" id="mob-nav-bookings"><i class="bi bi-bookmark-check-fill"></i><span>Bookings</span></a></li>
                </ul>
                <div class="nj-nav-category">Staff & Follow-ups</div>
                <ul class="nj-nav-list">
                    <li class="nj-nav-item"><a href="Employees.aspx" class="nj-nav-link" id="mob-nav-employees"><i class="bi bi-people-fill"></i><span>Employees</span></a></li>
                    <li class="nj-nav-item"><a href="EmployeeCategories.aspx" class="nj-nav-link" id="mob-nav-categories"><i class="bi bi-tags-fill"></i><span>Employee Categories</span></a></li>
                    <li class="nj-nav-item"><a href="FollowUps.aspx" class="nj-nav-link" id="mob-nav-followups"><i class="bi bi-calendar-check-fill"></i><span>Follow-ups</span></a></li>
                    <li class="nj-nav-item"><a href="CallHistory.aspx" class="nj-nav-link" id="mob-nav-calls"><i class="bi bi-telephone-outbound-fill"></i><span>Call History</span></a></li>
                </ul>
                <div class="nj-nav-category">Analytics & System</div>
                <ul class="nj-nav-list">
                    <%--<li class="nj-nav-item"><a href="Reports.aspx" class="nj-nav-link" id="mob-nav-reports"><i class="bi bi-bar-chart-fill"></i><span>Reports</span></a></li>
                    <li class="nj-nav-item"><a href="Settings.aspx" class="nj-nav-link" id="mob-nav-settings"><i class="bi bi-gear-fill"></i><span>Settings</span></a></li>
                  --%>
                    <li class="nj-nav-item"><a href="Profile.aspx" class="nj-nav-link" id="mob-nav-settings"><i class="bi bi-gear-fill"></i><span>Settings</span></a></li>

                </ul>
            </div>
            <div class="p-3 border-top border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <div class="nj-avatar">AD</div>
                    <div>
                        <div class="text-white small fw-bold">Admin Portal</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Gorakhpur, Uttar Pradesh</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Sidebar -->
        <aside class="nj-sidebar d-none d-lg-flex">
            <a href="Dashboard.aspx" class="nj-sidebar-brand">
                <img src="images/logo.png" alt="New Journey Holidays" class="brand-logo-img" />
                <div>
                    <div class="brand-title">New Journey Holidays</div>

                </div>
            </a>

            <div class="nj-nav-category">Lead Operations</div>
            <ul class="nj-nav-list">
                <li class="nj-nav-item">
                    <a href="Dashboard.aspx" class="nj-nav-link" id="nav-dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="AllLeads.aspx" class="nj-nav-link" id="nav-allleads">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>All Leads</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="AddLead.aspx" class="nj-nav-link" id="nav-addlead">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Add Lead</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="AssignLeads.aspx" class="nj-nav-link" id="nav-assignleads">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Assign Leads</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="Bookings.aspx" class="nj-nav-link" id="nav-bookings">
                        <i class="bi bi-bookmark-check-fill"></i>
                        <span>Bookings</span>
                    </a>
                </li>
            </ul>

            <div class="nj-nav-category">Team & Activity</div>
            <ul class="nj-nav-list">
                <li class="nj-nav-item">
                    <a href="Employees.aspx" class="nj-nav-link" id="nav-employees">
                        <i class="bi bi-people-fill"></i>
                        <span>Employees</span>
                    </a>
                </li>
                <%-- <li class="nj-nav-item">
                    <a href="EmployeeCategories.aspx" class="nj-nav-link" id="nav-categories">
                        <i class="bi bi-tags-fill"></i>
                        <span>Employee Categories</span>
                    </a>
                </li>--%>
                <%-- <li class="nj-nav-item">
                    <a href="FollowUps.aspx" class="nj-nav-link" id="nav-followups">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>Follow-ups</span>
                    </a>
                </li>--%>
                <li class="nj-nav-item">
                    <a href="CallHistory.aspx" class="nj-nav-link" id="nav-calls">
                        <i class="bi bi-telephone-outbound-fill"></i>
                        <span>Call History</span>
                    </a>
                </li>
            </ul>

            <div class="nj-nav-category">Account</div>
            <ul class="nj-nav-list">
               <%-- <li class="nj-nav-item">
                    <a href="Reports.aspx" class="nj-nav-link" id="nav-reports">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Reports</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="Settings.aspx" class="nj-nav-link" id="nav-settings">
                        <i class="bi bi-gear-fill"></i>
                        <span>Settings</span>
                    </a>
                </li>--%>

                <li class="nj-nav-item">
                    <a href="Profile.aspx" class="nj-nav-link" id="nav-profile">
                        <i class="bi bi-person-circle"></i>
                        <span>Profile</span>
                    </a>
                </li>
            </ul>

            <div class="nj-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-white-50" style="font-size: 0.725rem;">Branch</span>
                    <span class="nj-agency-badge"><i class="bi bi-geo-alt-fill"></i>Gorakhpur, UP</span>
                </div>
                <div class="text-white-50" style="font-size: 0.7rem; line-height: 1.3;">
                    Travel Agency CRM v2.4<br />
                    Unified Admin Interface
               
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="nj-main-wrapper">
            <!-- Top Navbar -->
            <header class="nj-topbar">
                <div class="nj-topbar-left">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                </div>

                <div class="nj-topbar-right">
                    <!-- Quick Add Lead Button -->
                    <a href="AddLead.aspx" class="btn btn-nj-primary btn-sm d-none d-md-inline-flex">
                        <i class="bi bi-plus-lg"></i>
                        <span>New Lead</span>
                    </a>

                    <!-- Notifications Dropdown -->
                    <div class="dropdown">
                        <button class="nj-icon-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="badge-dot"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm border p-0" style="width: 320px; font-size: 0.85rem;" aria-labelledby="notifDropdown">
                            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                                <span class="fw-bold text-dark">Notifications (3 New)</span>
                                <span class="badge bg-success">Today</span>
                            </div>
                            <div class="list-group list-group-flush" style="max-height: 280px; overflow-y: auto;">
                                <a href="FollowUps.aspx" class="list-group-item list-group-item-action p-2 px-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-danger-subtle text-danger">Follow-up</span>
                                        <span class="text-muted small">In 15 mins</span>
                                    </div>
                                    <div class="fw-semibold text-dark">Rohit Verma - Kashmir Inquiry</div>
                                    <div class="text-muted small">Assigned to: Priya Sharma</div>
                                </a>
                                <a href="AllLeads.aspx" class="list-group-item list-group-item-action p-2 px-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-success-subtle text-success">Confirmed</span>
                                        <span class="text-muted small">1 hour ago</span>
                                    </div>
                                    <div class="fw-semibold text-dark">Dubai Luxury Tour Booking Confirmed</div>
                                    <div class="text-muted small">Lead Owner: Rakesh Yadav (Field)</div>
                                </a>
                                <a href="AssignLeads.aspx" class="list-group-item list-group-item-action p-2 px-3 border-0">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-warning-subtle text-warning">Unassigned</span>
                                        <span class="text-muted small">2 hours ago</span>
                                    </div>
                                    <div class="fw-semibold text-dark">4 new website leads need assignment</div>
                                    <div class="text-muted small">Gorakhpur & Basti inquiries</div>
                                </a>
                            </div>
                            <div class="p-2 text-center border-top bg-light">
                                <a href="FollowUps.aspx" class="text-decoration-none small text-success fw-bold">View All Reminders</a>
                            </div>
                        </div>
                    </div>

                    <!-- Admin Profile Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="nj-user-profile dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nj-avatar">AD</div>
                            <div class="nj-user-info d-none d-sm-flex">
                                <span class="nj-user-name">Admin Portal</span>
                                <span class="nj-user-role">Director / Gorakhpur</span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border" aria-labelledby="userDropdown">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold">Director / Admin</div>
                                <div class="text-muted small">admin@newjourneyholidays.com</div>
                            </li>
                            <li><a class="dropdown-item py-2" href="Dashboard.aspx"><i class="bi bi-grid-1x2 me-2 text-success"></i>Dashboard</a></li>
                            <li><a class="dropdown-item py-2" href="Settings.aspx"><i class="bi bi-gear me-2 text-success"></i>CRM Settings</a></li>
                            <li><a class="dropdown-item py-2" href="Reports.aspx"><i class="bi bi-graph-up me-2 text-success"></i>Agency Reports</a></li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="Login.aspx">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Body Content -->
            <main class="nj-content-body">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>

            <!-- Simple Footer -->
            <footer class="nj-footer">
                <div>
                    <strong>New Journey Holidays CRM</strong> – Travel Agency Management System &bull; Gorakhpur, Uttar Pradesh
               
                </div>
                <div>
                    <span>Design: White & Dark Green Professional Theme &bull; 2026</span>
                </div>
            </footer>
        </div>

        <!-- Logout Confirmation Modal (UI only) -->
        <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold" id="logoutModalLabel">Sign Out of Admin Panel?</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-muted small pt-2">
                        Are you sure you want to exit the New Journey Holidays CRM session?
                   
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="alert('Session logged out (UI sample).');" data-bs-dismiss="modal">Log Out</button>
                    </div>
                </div>
            </div>
        </div>

    </form>

    <!-- Active Menu Highlight Script -->
    <%-- <script>
        (function () {
            var path = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll('.nj-nav-link');
            var matched = false;

            links.forEach(function (link) {
                var href = link.getAttribute('href');
                if (href && path.indexOf(href.toLowerCase()) !== -1) {
                    link.classList.add('active');
                    matched = true;
                }
            });

            // Default to Dashboard if root or index
            if (!matched) {
                var dLink = document.getElementById('nav-dashboard');
                if (dLink) dLink.classList.add('active');
                var mLink = document.getElementById('mob-nav-dashboard');
                if (mLink) mLink.classList.add('active');
            }
        })();
    </script>--%>
</body>
</html>
