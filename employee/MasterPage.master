<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Employee Panel | New Journey Holidays CRM</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons 1.11.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Custom Employee Theme CSS (Kept inside employee folder) -->
    <link href="css/employee-style.css" rel="stylesheet" />

    <!-- Bootstrap 5.3.3 JS Bundle (in Head so Server Startup Scripts can call bootstrap modals) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Mobile Sidebar Offcanvas -->
        <div class="offcanvas offcanvas-start text-white d-lg-none" tabindex="-1" id="mobileSidebar" style="background-color: var(--nj-sidebar-bg) !important; width: 295px;">
            <div class="offcanvas-header border-bottom border-secondary border-opacity-25 p-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="nj-sidebar-brand p-0 border-0">
                        <img src="images/logo.png" alt="New Journey Holidays" class="brand-logo-img" />
                        <div>
                            <div class="brand-title">New Journey</div>
                            <div class="brand-sub">Holidays CRM &bull; Staff</div>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                <!-- Role / Category Preview in Mobile -->
                <div class="p-3 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-20">
                    <div class="text-white-50 small mb-1">Employee Perspective:</div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-light flex-grow-1" id="mobSwitchSales" onclick="switchCategoryView('Sales');">
                            <i class="bi bi-briefcase"></i>Sales
                       
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light flex-grow-1" id="mobSwitchCalling" onclick="switchCategoryView('Calling');">
                            <i class="bi bi-headset"></i>Calling
                       
                        </button>
                    </div>
                </div>

                <div class="nj-nav-category">Main Menu</div>
                <ul class="nj-nav-list">
                    <li class="nj-nav-item"><a href="Dashboard.aspx" class="nj-nav-link" id="mob-nav-dashboard"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a></li>
                    <li class="nj-nav-item"><a href="MyLeads.aspx" class="nj-nav-link" id="mob-nav-myleads"><i class="bi bi-person-lines-fill"></i><span>My Leads</span></a></li>
                    <li class="nj-nav-item"><a href="Add-Lead.aspx" class="nj-nav-link" id="mob-nav-addlead"><i class="bi bi-person-plus-fill"></i><span>Add Lead</span></a></li>
                </ul>
                <div class="nj-nav-category">Communications</div>
                <ul class="nj-nav-list">
                    <li class="nj-nav-item"><a href="FollowUps.aspx" class="nj-nav-link" id="mob-nav-followups"><i class="bi bi-calendar-check-fill"></i><span>Follow-ups</span></a></li>
                    <li class="nj-nav-item"><a href="CallHistory.aspx" class="nj-nav-link" id="mob-nav-calls"><i class="bi bi-telephone-outbound-fill"></i><span>Call History</span></a></li>
                </ul>
                <div class="nj-nav-category">Account</div>
                <ul class="nj-nav-list">
                    <li class="nj-nav-item"><a href="MyProfile.aspx" class="nj-nav-link" id="mob-nav-profile"><i class="bi bi-person-circle"></i><span>My Profile</span></a></li>
                </ul>
            </div>
            <div class="p-3 border-top border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <div class="nj-avatar bg-primary" id="mobAvatar">PS</div>
                    <div>
                        <div class="text-white small fw-bold" id="mobEmpName">Priya Sharma</div>
                        <div class="text-muted" style="font-size: 0.7rem;" id="mobEmpRole">Sales &bull; Field Operations</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Sidebar -->
        <aside class="nj-sidebar d-none d-lg-flex">
            <a href="Dashboard.aspx" class="nj-sidebar-brand">
                <img src="images/logo.png" alt="New Journey Holidays" class="brand-logo-img" />
                <div>
                    <div class="brand-title">New Journey</div>
                    <div class="brand-sub">Holidays CRM &bull; Staff</div>
                </div>
            </a>

            <!-- Role Badge in Sidebar -->
            <div class="px-3 pt-3 pb-1">
                <div class="p-2 rounded bg-black bg-opacity-25 border border-white border-opacity-10 text-center">
                    <div class="text-white-50" style="font-size: 0.7rem;">LOGGED IN CATEGORY</div>
                    <div class="fw-bold text-white small" id="sidebarCategoryName">
                        <i class="bi bi-briefcase-fill text-success me-1"></i>Sales (Field Work)
                   
                    </div>
                </div>
            </div>

            <div class="nj-nav-category">My Workspace</div>
            <ul class="nj-nav-list">
                <li class="nj-nav-item">
                    <a href="Dashboard.aspx" class="nj-nav-link" id="nav-dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="MyLeads.aspx" class="nj-nav-link" id="nav-myleads">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>My Leads</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="Add-Lead.aspx" class="nj-nav-link" id="nav-addlead">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Add Lead</span>
                    </a>
                </li>
            </ul>

            <div class="nj-nav-category">Customer Outreach</div>
            <ul class="nj-nav-list">
                <li class="nj-nav-item">
                    <a href="FollowUps.aspx" class="nj-nav-link" id="nav-followups">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>Follow-ups</span>
                    </a>
                </li>
                <li class="nj-nav-item">
                    <a href="CallHistory.aspx" class="nj-nav-link" id="nav-calls">
                        <i class="bi bi-telephone-outbound-fill"></i>
                        <span>Call History</span>
                    </a>
                </li>
            </ul>

            <div class="nj-nav-category">My Settings</div>
            <ul class="nj-nav-list">
                <li class="nj-nav-item">
                    <a href="MyProfile.aspx" class="nj-nav-link" id="nav-profile">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
            </ul>

            <div class="nj-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-white-50" style="font-size: 0.725rem;">Branch</span>
                    <span class="nj-agency-badge"><i class="bi bi-geo-alt-fill"></i>Gorakhpur HQ</span>
                </div>
                <div class="text-white-50" style="font-size: 0.7rem; line-height: 1.3;">
                    Unified Employee Panel<br />
                    Sales & Calling Operations
               
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="nj-main-wrapper">
            <!-- Top Navbar -->
            <header class="nj-topbar">
                <div class="nj-topbar-left">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="nj-topbar-title">
                            <span>New Journey Holidays</span>
                        </h1>

                    </div>
                </div>

                <div class="nj-topbar-right">
                    <!-- Quick Add Lead Button -->
                    <a href="Add-Lead.aspx" class="btn btn-nj-primary btn-sm d-none d-md-inline-flex">
                        <i class="bi bi-plus-lg"></i>
                        <span>New Lead</span>
                    </a>

                    <!-- Notifications Dropdown -->
                    <div class="dropdown">
                        <button class="nj-icon-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="badge-dot"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm border p-0" style="width: 320px; font-size: 0.85rem;" aria-labelledby="notifDropdown">
                            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                                <span class="fw-bold text-dark">Notifications (2 Reminders)</span>
                                <span class="badge bg-success">Today</span>
                            </div>
                            <div class="list-group list-group-flush" style="max-height: 260px; overflow-y: auto;">
                                <a href="FollowUps.aspx" class="list-group-item list-group-item-action p-2 px-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-danger-subtle text-danger">Due in 30m</span>
                                        <span class="text-muted small">02:30 PM</span>
                                    </div>
                                    <div class="fw-semibold text-dark">Dr. Arvind Kumar - Char Dham Heli</div>
                                    <div class="text-muted small">Follow-up call scheduled today</div>
                                </a>
                                <a href="MyLeads.aspx" class="list-group-item list-group-item-action p-2 px-3 border-0">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary-subtle text-primary">Assigned Lead</span>
                                        <span class="text-muted small">Today</span>
                                    </div>
                                    <div class="fw-semibold text-dark">Rohit Verma - Kashmir 5N/6D</div>
                                    <div class="text-muted small">Assigned by Admin for calling</div>
                                </a>
                            </div>
                            <div class="p-2 text-center border-top bg-light">
                                <a href="FollowUps.aspx" class="text-decoration-none small text-success fw-bold">View Today's Follow-ups</a>
                            </div>
                        </div>
                    </div>

                    <!-- Employee Profile Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="nj-user-profile dropdown-toggle"
                            id="empProfileDropdown" data-bs-toggle="dropdown"
                            aria-expanded="false">

                            <div class="nj-avatar bg-primary">
                                <asp:Literal ID="litHeaderAvatar" runat="server" Mode="Encode" />
                            </div>

                            <div class="nj-user-info d-none d-sm-flex">
                                <span class="nj-user-name">
                                    <asp:Literal ID="litHeaderName" runat="server" Mode="Encode" />
                                </span>

                                <span class="nj-user-role">
                                    <asp:Literal ID="litHeaderCategory" runat="server" Mode="Encode" />
                                </span>
                            </div>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border"
                            aria-labelledby="empProfileDropdown">

                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold">
                                    <asp:Literal ID="litMenuName" runat="server" Mode="Encode" />
                                </div>

                                <div class="text-muted small">
                                    @<asp:Literal ID="litMenuUsername" runat="server" Mode="Encode" />
                                </div>

                                <div class="text-muted small">
                                    <asp:Literal ID="litMenuEmail" runat="server" Mode="Encode" />
                                </div>

                                <div class="mt-1">
                                    <span class="badge badge-cat-sales">
                                        <asp:Literal ID="litMenuCategory" runat="server" Mode="Encode" />
                                    </span>
                                </div>
                            </li>

                            <li>
                                <a class="dropdown-item py-2" href="Dashboard.aspx">
                                    <i class="bi bi-grid-1x2 me-2 text-success"></i>My Dashboard
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item py-2" href="MyLeads.aspx">
                                    <i class="bi bi-person-lines-fill me-2 text-success"></i>My Leads Directory
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item py-2" href="MyProfile.aspx">
                                    <i class="bi bi-person-circle me-2 text-success"></i>My Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a class="dropdown-item py-2 text-danger" href="Employee_Login.aspx">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Body Content -->
            <main class="nj-content-body">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>

            <!-- Footer -->
            <footer class="nj-footer">
                <div>
                    <strong>New Journey Holidays CRM</strong> &bull; Employee Panel &bull; Gorakhpur, Uttar Pradesh
               
                </div>
                <div>
                    <span>Unified Panel: Sales & Calling Team &bull; 2026</span>
                </div>
            </footer>
        </div>

        <!-- Logout Confirmation Modal (UI only) -->
        <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold" id="logoutModalLabel">Sign Out of Employee Panel?</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-muted small pt-2">
                        Are you sure you want to exit your session? Any unsaved form drafts will be discarded.
                   
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="alert('Session signed out (UI sample).');" data-bs-dismiss="modal">Log Out</button>
                    </div>
                </div>
            </div>
        </div>

    </form>

    

    <!-- Active Menu & Role Switcher Script -->
    <script>
        // Category switching function to demonstrate both Sales and Calling perspectives in the same panel
        function switchCategoryView(category) {
            localStorage.setItem('nj_employee_category', category);
            updateHeaderCategoryUI(category);

            // Trigger custom event if page wants to react
            var event = new CustomEvent('njCategoryChanged', { detail: { category: category } });
            window.dispatchEvent(event);
        }

        function updateHeaderCategoryUI(category) {
            var btnSales = document.getElementById('btnRoleSales');
            var btnCalling = document.getElementById('btnRoleCalling');
            var sidebarBadge = document.getElementById('sidebarCategoryName');
            var headerRole = document.getElementById('headerEmpCategory');
            var headerName = document.getElementById('headerEmpName');
            var headerAvatar = document.getElementById('headerAvatar');
            var menuName = document.getElementById('menuEmpName');
            var menuEmail = document.getElementById('menuEmpEmail');
            var menuBadge = document.getElementById('menuCatBadge');
            var mobName = document.getElementById('mobEmpName');
            var mobRole = document.getElementById('mobEmpRole');
            var mobAvatar = document.getElementById('mobAvatar');

            if (category === 'Calling') {
                if (btnSales) btnSales.classList.remove('active');
                if (btnCalling) btnCalling.classList.add('active');
                if (sidebarBadge) sidebarBadge.innerHTML = '<i class="bi bi-headset text-info me-1"></i> Calling (Back Office)';
                if (headerRole) headerRole.textContent = 'Calling Employee (Back Office)';
                if (headerName) headerName.textContent = 'Pooja Srivastava';
                if (headerAvatar) { headerAvatar.textContent = 'PS'; headerAvatar.className = 'nj-avatar bg-info'; }
                if (menuName) menuName.textContent = 'Pooja Srivastava';
                if (menuEmail) menuEmail.textContent = 'pooja@newjourneyholidays.com';
                if (menuBadge) { menuBadge.className = 'badge badge-cat-calling'; menuBadge.textContent = 'Category: Calling (Back Office)'; }
                if (mobName) mobName.textContent = 'Pooja Srivastava';
                if (mobRole) mobRole.textContent = 'Calling • Back Office Desk';
                if (mobAvatar) { mobAvatar.textContent = 'PS'; mobAvatar.className = 'nj-avatar bg-info'; }
            } else {
                if (btnSales) btnSales.classList.add('active');
                if (btnCalling) btnCalling.classList.remove('active');
                if (sidebarBadge) sidebarBadge.innerHTML = '<i class="bi bi-briefcase-fill text-success me-1"></i> Sales (Field Work)';
                if (headerRole) headerRole.textContent = 'Sales Employee (Field)';
                if (headerName) headerName.textContent = 'Priya Sharma';
                if (headerAvatar) { headerAvatar.textContent = 'PS'; headerAvatar.className = 'nj-avatar bg-primary'; }
                if (menuName) menuName.textContent = 'Priya Sharma';
                if (menuEmail) menuEmail.textContent = 'priya@newjourneyholidays.com';
                if (menuBadge) { menuBadge.className = 'badge badge-cat-sales'; menuBadge.textContent = 'Category: Sales (Field)'; }
                if (mobName) mobName.textContent = 'Priya Sharma';
                if (mobRole) mobRole.textContent = 'Sales • Field Operations';
                if (mobAvatar) { mobAvatar.textContent = 'PS'; mobAvatar.className = 'nj-avatar bg-primary'; }
            }
        }

        // Initialize state on load
        (function () {
            var savedCat = localStorage.getItem('nj_employee_category') || 'Sales';
            updateHeaderCategoryUI(savedCat);

            // Active menu link highlight
            var path = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll('.nj-nav-link');
            var matched = false;

            links.forEach(function (link) {
                var href = link.getAttribute('href');
                if (href && path.indexOf(href.toLowerCase()) !== -1) {
                    link.classList.add('active');
                    matched = true;
                }
            });

            if (!matched) {
                var dLink = document.getElementById('nav-dashboard');
                if (dLink) dLink.classList.add('active');
                var mLink = document.getElementById('mob-nav-dashboard');
                if (mLink) mLink.classList.add('active');
            }
        })();
    </script>
</body>
</html>
